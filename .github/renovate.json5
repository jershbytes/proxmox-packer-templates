{
  extends: [
    'config:recommended',
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/config.pkr.hcl/',
        '/.yml/',
        '/.pkrvars.hcl/',
      ],
      matchStrings: [
        'githubReleaseVar repo=(?<depName>.*?)\n .*version = "(?<currentValue>.*)"\n',
        'githubReleaseVar repo=(?<depName>.*?)\n .*version: (?<currentValue>.*)\n',
        'githubReleaseVar repo=(?<depName>.*?)\n .*SCHEMATIC/(?<currentValue>.*)/nocloud',
      ],
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/.pkrvars.hcl/',
        '/.cfg/',
      ],
      matchStrings: [
        'datasource=(?<datasource>\\S+)\nname *= "(?<depName>.*?)"[\\s\\S]*?iso_file *= "debian-(?<currentValue>.*?)-amd64-netinst.iso"[\\s\\S]*?iso_url *= "(?<registryUrl>https://cdimage\\.debian\\.org/mirror/cdimage/archive/)(.*)/amd64/iso-cd/debian-(.*)-amd64-netinst.iso"[\\s\\S]*?iso_checksum *= "file:.*/amd64/iso-cd/SHA256SUMS"',
        'datasource=(?<datasource>\\S+)\nname *= "(?<depName>.*?)"[\\s\\S]*?iso_file *= "ubuntu-(?<currentValue>.*?)-.*server-amd64.iso"[\\s\\S]*?iso_url *= "(?<registryUrl>https://(?:old-releases|releases)\\.ubuntu\\.com/releases/)(.*)/ubuntu-(.*)-.*server-amd64.iso"',
        'datasource=(?<datasource>\\S+)\nname *= "(?<depName>.*?)"[\\s\\S]*?iso_file *= "alpine-virt-(?<currentValue>.*?)-x86_64.iso"[\\s\\S]*?iso_url *= "(?<registryUrl>.*)/alpine-virt-(.*)-x86_64.iso"[\\s\\S]*?iso_checksum *= "file:.*/alpine-virt-(.*)-x86_64.iso.sha256"',
        'datasource=(?<datasource>\\S+)\nname *= "(?<depName>.*?)"[\\s\\S]*?iso_file *= "Rocky-(?<currentValue>.*?)-x86_64-minimal.iso"[\\s\\S]*?iso_url *= "(?<registryUrl>.*)/(.*)/isos/x86_64/Rocky-(.*)-x86_64-minimal.iso"[\\s\\S]*?iso_checksum *= "file:.*/(.*)/isos/x86_64/CHECKSUM"',
        'datasource=(?<datasource>\\S+) depName=(?<depName>.*?)\nrepo --name="BaseOS" --baseurl=http://download.rockylinux.org/pub/rocky/(?<currentValue>.*?)/BaseOS/x86_64/os/',
        'datasource=(?<datasource>\\S+) depName=(?<depName>.*?)\nrepo --name="AppStream" --baseurl=http://download.rockylinux.org/pub/rocky/(?<currentValue>.*?)/AppStream/x86_64/os/',
        'datasource=(?<datasource>\\S+)\nname *= "(?<depName>.*?)"[\\s\\S]*?iso_file *= "AlmaLinux-(?<currentValue>.*?)-x86_64-minimal.iso"[\\s\\S]*?iso_url *= "(?<registryUrl>.*)/(.*)/isos/x86_64/AlmaLinux-(.*)-x86_64-minimal.iso"[\\s\\S]*?iso_checksum *= "file:.*/(.*)/isos/x86_64/CHECKSUM"',
        'datasource=(?<datasource>\\S+) depName=(?<depName>.*?)\nrepo --name="BaseOS" --baseurl=http://repo.almalinux.org/almalinux/(?<currentValue>.*?)/BaseOS/x86_64/os/',
        'datasource=(?<datasource>\\S+) depName=(?<depName>.*?)\nrepo --name="AppStream" --baseurl=http://repo.almalinux.org/almalinux/(?<currentValue>.*?)/AppStream/x86_64/os/',
        'datasource=(?<datasource>\\S+)\nname *= "(?<depName>.*?)"[\\s\\S]*?iso_file *= "OPNsense-(?<currentValue>.*?)-dvd-amd64.iso"[\\s\\S]*?iso_url *= "(?<registryUrl>.*/)(.*)/OPNsense-(.*)-dvd-amd64.iso.bz2"[\\s\\S]*?iso_checksum *= "file:.*/OPNsense-(.*)-checksums-amd64.sha256"',
      ],
      datasourceTemplate: '{{ datasource }}',
    },
  ],
  packageRules: [
    {
      matchPackageNames: [
        'hashicorp/packer',
        'hashicorp/terraform',
      ],
      extractVersion: '^v(?<version>.*)$',
    },
    {
      matchDatasources: [
        'custom.debianLinuxRelease',
        'custom.ubuntuLinuxRelease',
      ],
      extractVersion: '^(?<version>\\d+.\\d+.\\d+)/$',
    },
    {
      matchDatasources: [
        'custom.rockyLinuxRelease',
        'custom.almaLinuxRelease',
        'custom.opnsenseRelease',
      ],
      extractVersion: '^(?<version>\\d+.\\d+)/$',
    },
    {
      matchDatasources: [
        'custom.alpineLinuxRelease',
      ],
      extractVersion: '^alpine-virt-(?<version>\\d+.\\d+.\\d+)-x86_64.iso$',
    },
    {
      matchDatasources: [
        'custom.ubuntuLinuxRelease',
      ],
      versioning: 'ubuntu',
    },
    {
      matchDatasources: [
        'custom.debianLinuxRelease',
        'custom.ubuntuLinuxRelease',
        'custom.rockyLinuxRelease',
        'custom.almaLinuxRelease',
        'custom.opnsenseRelease',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
    {
      matchDatasources: [
        'custom.alpineLinuxRelease',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
      ],
      enabled: false,
    },
    {
      matchPackageNames: [
        'siderolabs/talos',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
      ],
      enabled: false,
    },
  ],
  customDatasources: {
    debianLinuxRelease: {
      defaultRegistryUrlTemplate: 'https://cdimage.debian.org/mirror/cdimage/archive/',
      format: 'html',
    },
    ubuntuLinuxRelease: {
      defaultRegistryUrlTemplate: 'https://old-releases.ubuntu.com/releases/',
      format: 'html',
    },
    alpineLinuxRelease: {
      defaultRegistryUrlTemplate: 'https://dl-cdn.alpinelinux.org/alpine/',
      format: 'html',
    },
    rockyLinuxRelease: {
      defaultRegistryUrlTemplate: 'https://download.rockylinux.org/pub/rocky/',
      format: 'html',
    },
    almaLinuxRelease: {
      defaultRegistryUrlTemplate: 'https://repo.almalinux.org/almalinux/',
      format: 'html',
    },
    opnsenseRelease: {
      defaultRegistryUrlTemplate: 'https://pkg.opnsense.org/releases/',
      format: 'html',
    },
  },
}